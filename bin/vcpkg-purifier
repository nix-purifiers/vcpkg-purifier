#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
import sys,subprocess
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib/vcpkg-purifier'))
from vcpkg_purifier.cli import main
if __name__ == '__main__':
    try: main()
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print('vcpkg-purifier: '+str(error), file=sys.stderr)
        sys.exit(1)
